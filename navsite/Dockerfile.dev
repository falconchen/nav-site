FROM ruby:3.4

# libsqlite3-dev: sqlite3 gem 的原生扩展
# libvips:        ActiveStorage variant（image_processing）运行时依赖
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends libsqlite3-dev libvips && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV BUNDLE_PATH=/bundle

COPY Gemfile Gemfile.lock ./
RUN bundle install

COPY . .

EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
