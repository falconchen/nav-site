<main class="auth-container">
  <div class="auth-card">
    <div class="auth-brand">
      <i class="fas fa-compass"></i>
      <span>皮皮2047</span>
    </div>
    <h1 class="auth-title">登录</h1>

    <% if flash[:alert] %>
      <div class="form-errors"><i class="fas fa-circle-exclamation"></i> <%= flash[:alert] %></div>
    <% end %>
    <% if flash[:notice] %>
      <div class="form-notice"><i class="fas fa-circle-check"></i> <%= flash[:notice] %></div>
    <% end %>

    <%= form_with url: session_path, class: "auth-form" do |f| %>
      <div class="form-group">
        <%= f.label :email_address, "邮箱", class: "form-label" %>
        <%= f.email_field :email_address, class: "form-input", required: true, autofocus: true,
                          autocomplete: "username", value: params[:email_address] %>
      </div>

      <div class="form-group">
        <%= f.label :password, "密码", class: "form-label" %>
        <%= f.password_field :password, class: "form-input", required: true,
                             autocomplete: "current-password", maxlength: 72 %>
      </div>

      <%= f.submit "登录", class: "btn btn-primary btn-block" %>
    <% end %>

    <p class="auth-alt">还没有账号？<%= link_to "注册", new_registration_path %></p>
  </div>
</main>
