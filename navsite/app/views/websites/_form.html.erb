<%= form_with model: website, class: "website-form" do |f| %>
  <% if website.errors.any? %>
    <div class="form-errors">
      <% website.errors.full_messages.each do |msg| %>
        <div><i class="fas fa-circle-exclamation"></i> <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <%= hidden_field_tag :section, anchor %>

  <div class="form-group">
    <%= f.label :url, "网址链接 *", class: "form-label" %>
    <%= f.url_field :url, class: "form-input", placeholder: "https://example.com", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :title, "网站名称 *", class: "form-label" %>
    <%= f.text_field :title, class: "form-input", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :category_id, "所属分类 *", class: "form-label" %>
    <%= f.collection_select :category_id, Category.ordered, :id, :name, {}, class: "form-select", required: true %>
  </div>

  <div class="form-group">
    <%= f.label :icon, "图标", class: "form-label" %>
    <%= f.text_field :icon, class: "form-input", placeholder: "fas fa-globe 或图标 URL" %>
  </div>

  <div class="form-group">
    <%= f.label :description, "简短描述", class: "form-label" %>
    <%= f.text_area :description, class: "form-textarea", rows: 2 %>
  </div>

  <div class="form-group form-checks">
    <label class="checkbox-label">
      <%= f.check_box :pinned %> <i class="fas fa-thumbtack"></i> 置顶
    </label>
    <label class="checkbox-label">
      <%= f.check_box :hidden %> <i class="fas fa-eye-slash"></i> 对访客隐藏
    </label>
  </div>

  <div class="form-buttons">
    <% if cancel_href.present? %>
      <%= link_to "取消", cancel_href, class: "btn btn-secondary" %>
    <% end %>
    <%= f.submit website.persisted? ? "保存" : "添加", class: "btn btn-primary" %>
  </div>
<% end %>
