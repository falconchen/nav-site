{
	"name": "nav-site",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "node build-script.js",
		"build:firefox": "node build-firefox-extension.js",
		"sign:firefox": "npm run build:firefox && npx -y web-ext@10 sign --channel=unlisted --source-dir extension-firefox --artifacts-dir web-ext-artifacts",
		"release:firefox": "node release-firefox-extension.js",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"test:frontend": "node --test test/frontend-loading.node.cjs",
		"deploy": "npm run build && wrangler deploy --env production"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.3.6",
		"vitest": "~4.1.11",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"esbuild": "^0.28.1",
		"fs-extra": "^11.3.0",
		"hono": "^4.13.12",
		"html-minifier-terser": "^7.2.0",
		"htmlparser2": "^9.1.0"
	}
}
